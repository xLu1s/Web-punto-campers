---
import { faqs } from '../data/faq';
---
<section class="section" id="homologacion" aria-labelledby="faq-titulo">
  <div class="wrap faq-grid">
    <div class="reveal">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 id="faq-titulo" class="titulo">Homologación <b>e ITV</b></h2>
      <p class="lead">Lo que más nos preguntáis antes de camperizar.</p>
    </div>
    <div class="faq reveal reveal-d1">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
