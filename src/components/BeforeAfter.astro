---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { antes: ImageMetadata; despues: ImageMetadata; titulo: string; detalle?: string; }
const { antes, despues, titulo, detalle } = Astro.props;
---
<figure class="ad-wrap" style="margin:0">
  <div class="ad" data-ad style={`--pos:50%;aspect-ratio:${antes.width} / ${antes.height}`}>
    <Image src={despues} alt={`${titulo}: después`} widths={[480, 760, 1100]} sizes="(min-width: 1000px) 520px, 92vw" class="ad__despues" loading="eager" />
    <Image src={antes} alt={`${titulo}: antes`} widths={[480, 760, 1100]} sizes="(min-width: 1000px) 520px, 92vw" class="ad__antes" loading="eager" />
    <span class="ad__tag ad__tag--antes">Antes</span>
    <span class="ad__tag ad__tag--despues">Después</span>
    <input class="ad__rango" type="range" min="0" max="100" step="1" value="50" aria-label={`Comparar antes y después: ${titulo}`} aria-valuetext="50 % antes" data-ad-rango />
    <span class="ad__linea" aria-hidden="true"></span>
    <span class="ad__mango" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"/></svg>
    </span>
  </div>
  <figcaption class="galeria__cap" style="position:static;background:none;padding:.8rem 0 0">
    <strong>{titulo}</strong>{detalle && <span>{detalle}</span>}
  </figcaption>
</figure>
