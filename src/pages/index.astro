---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Modelos from '../components/Modelos.astro';
import Servicios from '../components/Servicios.astro';
import Triangulos from '../components/Triangulos.astro';
import Proyectos from '../components/Proyectos.astro';
import Proceso from '../components/Proceso.astro';
import Resenas from '../components/Resenas.astro';
import VideoYT from '../components/VideoYT.astro';
import Faq from '../components/Faq.astro';
import Presupuesto from '../components/Presupuesto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Banner from '../components/Banner.astro';
---
<Base
  title="Camperización de furgonetas en Alcoi (Alicante) | Punto Campers"
  description="Taller de camperización en Alcoi: camperizaciones completas, kits camper, muebles a medida y homologación ITV. Modelos desde 12.000 € IVA incluido. Pide presupuesto."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Intro />
    <Modelos />
    <Servicios />
    <Triangulos />
    <Proyectos />
    <Proceso />
    <Resenas />
    <VideoYT />
    <Banner />
    <Faq />
    <Presupuesto />
  </main>
  <Footer />
  <WhatsAppFab />
</Base>
